import pandas as pd

# Read the CSV file containing sample information
samples_df = pd.read_csv(config["samples"]["sample_list"])
base_dir = config["base_dir"]

# Extract sample names and file paths
SAMPLES = samples_df["sample_name"].tolist()  # Adjust column name as needed
SAMPLE_PATHS = dict(zip(samples_df["sample_name"], samples_df["file_path"]))  # Adjust column names


# Generate dynamic filename components from config
af_str = str(config["thresholds"]["af_threshold"]).replace(".", "p")
cadd_str = str(int(config["thresholds"]["cadd_threshold"])) + "p0"
filter_suffix = f"af{af_str}.cadd{cadd_str}"

rule all:
    input:
        expand("{sample_path}/annotate_snv/case_{sample}_snv.annotated." + filter_suffix + ".rare_variants.vcf", 
               zip, sample_path=[SAMPLE_PATHS[s] for s in SAMPLES], sample=SAMPLES)


rule print_sample_paths:
    input:
        vcf="{sample_path}/call_snv/genome/case_{sample}_snv.vcf.gz"

    output:
        cadd="{sample_path}/annotate_snv/case_{sample}_snv_CADD_GRCh38.tsv.gz"

    threads: workflow.cores  # Will use the threads set in profile


    shell:
        """
        echo "Processing sample: {wildcards.sample}"
        echo "Input VCF: {input.vcf}"
        echo "Output directory: {wildcards.sample_path}/annotate_snv"

	PATH=/work/hassan/hassan/miniforge:$PATH
	source /work/hassan/hassan/miniforge/etc/profile.d/conda.sh
	# touch {output.cadd}
        
        # Run CADD script
        bash snakeotate/workflow/scripts/cadd.sh {input.vcf} {wildcards.sample_path}/annotate_snv
        """

rule run_vep_annotation:
    input:
        vcf="{sample_path}/call_snv/genome/case_{sample}_snv.vcf.gz",
        cadd="{sample_path}/annotate_snv/case_{sample}_snv_CADD_GRCh38.tsv.gz"
    output:
        annotated="{sample_path}/annotate_snv/case_{sample}_snv.annotated.vcf"

    shell:
        """
        echo "Running VEP annotation for sample: {wildcards.sample}"
        echo "Input VCF: {input.vcf}"
        echo "CADD file: {input.cadd}"
        echo "Output directory: {wildcards.sample_path}/annotate_snv"
        
        # Run VEP script
        bash snakeotate/workflow/scripts/vep.sh \
            -i {input.vcf} \
            -c {input.cadd} \
            -o {wildcards.sample_path}/annotate_snv
        
        echo "VEP annotation completed for {wildcards.sample}"
        """


rule filter_variants:
    input:
        annotated="{sample_path}/annotate_snv/case_{sample}_snv.annotated.vcf"
    output:
        filtered_vcf="{sample_path}/annotate_snv/case_{sample}_snv.annotated.{filter_suffix}.rare_variants.vcf",
        filtered_tsv="{sample_path}/annotate_snv/case_{sample}_snv.annotated.{filter_suffix}.rare_variants.tsv"

    conda:
        "envs/filter.yaml"
    params:
        af_threshold=config["thresholds"]["af_threshold"],
        cadd_threshold=config["thresholds"]["cadd_threshold"],
        additional_fields="Consequence,IMPACT,SYMBOL,Gene,Feature_type,Feature,BIOTYPE,SYMBOL_SOURCE,HGNC_ID"
    shell:
        """
        echo "Filtering variants for sample: {wildcards.sample}"
        echo "Input annotated VCF: {input.annotated}"
        echo "Output directory: {wildcards.sample_path}/annotate_snv/"
        
        # Run filtering script
        python snakeotate/workflow/scripts/filter.py \
            {input.annotated} \
            {wildcards.sample_path}/annotate_snv/ \
            {params.af_threshold} \
            {params.cadd_threshold} \
            "{params.additional_fields}"
        
        echo "Variant filtering completed for {wildcards.sample}"
        """
